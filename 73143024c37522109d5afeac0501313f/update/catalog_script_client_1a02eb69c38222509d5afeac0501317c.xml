        <script><![CDATA[function onLoad() {
    // 当请求处于拒绝状态时显示提醒
    if (g_form.getValue('my_request_status') == 'Rejected' && 
        g_form.getValue('resubmit_allowed') == 'true') {
        
        var reason = g_form.getValue('reject_reason') || '未提供原因';
        
        // 创建醒目的提示信息
        var html = '<div class="notification notification-warning">' +
                   '<span class="icon icon-warning"></span>' +
                   '<div class="notification-content">' +
                   '<h4>此请求已被拒绝</h4>' +
                   '<p><strong>拒绝原因:</strong> ' + reason + '</p>' +
                   '<p>请修改后点击"Resubmit"按钮重新提交</p>' +
                   '</div></div>';
        
        // 在表单顶部显示
        g_form.showFieldMsg('number', html, 'info', true);
    }
}]]></script>
