        <messages/>
        <name>PDF Download Button</name>
        <order/>
        <script><![CDATA[function onLoad() {
    try {
        console.log('[PDF生成器] onLoad事件触发');
        
        if (!g_form) {
            console.error('[PDF生成器] g_form对象未定义');
            return;
        }
        
        if (g_form.isValidRecord()) {
            console.log('[PDF生成器] 当前记录有效，ID:', g_form.getUniqueValue());
            addCustomButton();
        } else {
            console.log('[PDF生成器] 当前记录无效，不添加按钮');
        }
    } catch (e) {
        console.error('[PDF生成器] onLoad执行错误:', e);
    }
}

function addCustomButton() {
    try {
        console.log('[PDF生成器] 开始添加按钮');
        
        // 创建自定义按钮
        var button = document.createElement('button');
        button.type = 'button';
        button.className = 'btn btn-primary';
        button.innerHTML = '<i class="fa fa-file-pdf-o"></i> Download as PDF';
        button.onclick = downloadPDF;
        
        // 尝试所有可能的容器位置
        var containers = [
            '.form-buttons',
            '.form-footer',
            '.navigator-body',
            '.section-body',
            'form'
        ];
        
        for (var i = 0; i < containers.length; i++) {
            var container = document.querySelector(containers[i]);
            if (container) {
                console.log('[PDF生成器] 找到容器:', containers[i]);
                container.appendChild(button);
                console.log('[PDF生成器] 按钮添加成功');
                return;
            }
        }
        
        console.error('[PDF生成器] 未找到任何合适的容器');
        
        // 作为最后的手段，添加到页面底部
        document.body.appendChild(button);
        console.log('[PDF生成器] 按钮已添加到页面底部');
        
    } catch (e) {
        console.error('[PDF生成器] 添加按钮时出错:', e);
    }
}

function downloadPDF() {
    try {
        console.log('[PDF生成器] 开始生成PDF');
        
        var recordId = g_form.getUniqueValue();
        var tableName = g_form.getTableName();
        
        if (!recordId || !tableName) {
            console.error('[PDF生成器] 记录ID或表名缺失');
            alert('无法获取当前记录信息');
            return;
        }
        
        console.log('[PDF生成器] 记录ID:', recordId, '表名:', tableName);
        
        var ga = new GlideAjax('PDFGenerationScript');
        ga.addParam('sysparm_name', 'generatePDF');
        ga.addParam('sysparm_table_name', tableName);
        ga.addParam('sysparm_record_id', recordId);
        ga.getXML(function(response) {
            try {
                var answer = response.responseXML.documentElement.getAttribute("answer");
                console.log('[PDF生成器] 服务器响应:', answer);
                
                if (answer) {
                    var downloadUrl = '/sys_attachment.do?sys_id=' + answer + '&view=true';
                    console.log('[PDF生成器] 下载URL:', downloadUrl);
                    window.open(downloadUrl, '_blank');
                } else {
                    alert('PDF生成失败，请联系管理员。');
                }
            } catch (e) {
                console.error('[PDF生成器] 处理服务器响应时出错:', e);
                alert('处理PDF下载时出错');
            }
        });
    } catch (e) {
        console.error('[PDF生成器] 下载PDF时出错:', e);
        alert('生成PDF时出错');
    }
}]]></script>
