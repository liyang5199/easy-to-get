        <name>GeneratePDFAjax</name>
        <sandbox_callable>true</sandbox_callable>
        <script><![CDATA[var GeneratePDFAjax = Class.create();
GeneratePDFAjax.prototype = Object.extendsObject(AbstractAjaxProcessor, {
    generatePDF: function() {
        var sysId = this.getParameter('sysparm_sysid');
        var gr = new GlideRecord('x_1770592_easy_t_0_my_asset_request');
        if (gr.get(sysId)) {
            // 创建HTML内容
            var html = this._createHTMLContent(gr);
            
            // 生成PDF
            var pdf = new PDFDocument(html);
            var attachment = new GlideSysAttachment();
            var fileName = 'AssetRequest_' + sysId + '.pdf';
            var contentType = 'application/pdf';
            var attachmentSysId = attachment.write(gr, fileName, contentType, pdf.getStream());
            
            if (attachmentSysId) {
                // 返回PDF下载URL
                return '/sys_attachment.do?sys_id=' + attachmentSysId;
            }
        }
        return '';
    },
    
    _createHTMLContent: function(gr) {
        var html = '<html><head><style>' +
                   'body { font-family: Arial, sans-serif; }' +
                   'h1 { color: #036; }' +
                   'table { width: 100%; border-collapse: collapse; }' +
                   'th { background-color: #f2f2f2; text-align: left; padding: 8px; }' +
                   'td { padding: 8px; border-bottom: 1px solid #ddd; }' +
                   '</style></head><body>';
        
        html += '<h1>Asset Request Details</h1>';
        html += '<table>';
        html += '<tr><th>Field</th><th>Value</th></tr>';
        html += '<tr><td>Manager</td><td>' + gr.manager.getDisplayValue() + '</td></tr>';
        html += '<tr><td>Request for DR</td><td>' + gr.request_for_dr + '</td></tr>';
        html += '<tr><td>Computer Model</td><td>' + gr.computer_model + '</td></tr>';
        html += '<tr><td>Request Status</td><td>' + gr.my_request_status + '</td></tr>';
        html += '<tr><td>Notes</td><td>' + gr.my_notes + '</td></tr>';
        html += '</table></body></html>';
        
        return html;
    },
    
    type: 'GeneratePDFAjax'
});]]></script>
