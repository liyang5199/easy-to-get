        <script><![CDATA[var GlobalAjax = Class.create();
GlobalAjax.prototype = Object.extendsObject(AbstractAjaxProcessor, {
    
    generatePDF: function() {
        try {
            // === 1. 获取记录数据 ===
            var sysId = this.getParameter('sysparm_sysid');
            var gr = new GlideRecord('x_1770592_easy_t_0_my_asset_request');
            if (!gr.get(sysId)) return "ERROR: 记录不存在";

            // === 2. 准备数据（服务端安全获取）===
            var recordData = {
                manager: gr.getDisplayValue('manager') || '未填写', // 使用getDisplayValue获取引用字段显示值
                request_for_dr: gr.getValue('request_for_dr') || '未填写',
                computer_model: gr.getValue('computer_model') || '未填写',
                status: gr.getValue('my_request_status') || '未填写',
                notes: gr.getValue('my_notes') || '未填写',
                date: new GlideDateTime().getDisplayValue() // 服务端可安全调用
            };

            // === 3. 生成HTML（服务端模板）===
            var htmlTemplate = [
                '<html><head><meta charset="UTF-8"><style>',
                'body { font-family: "Microsoft YaHei", Arial; margin: 15mm; }',
                'h1 { color: #1a5276; text-align: center; }',
                '.label { font-weight: bold; width: 30%; }',
                '.footer { position: absolute; bottom: 0; font-size: 10px; }',
                '</style></head>',
                '<body>',
                '<h1>IT资产申请表</h1>',
                '<table style="width:100%; margin-top:20px;">',
                '<tr><td class="label">申请人：</td><td>' + recordData.manager + '</td></tr>',
                '<tr><td class="label">灾备需求：</td><td>' + recordData.request_for_dr + '</td></tr>',
                '<tr><td class="label">设备型号：</td><td>' + recordData.computer_model + '</td></tr>',
                '<tr><td class="label">申请状态：</td><td>' + recordData.status + '</td></tr>',
                '<tr><td class="label" style="vertical-align:top;">补充说明：</td><td>' + recordData.notes.replace(/\n/g, '<br>') + '</td></tr>',
                '</table>',
                '<div class="footer">系统生成时间：' + recordData.date + '</div>',
                '</body></html>'
            ].join('');

            // === 4. 生成PDF附件 ===
            var pdfGen = new Packages.com.servicenow.misc.PDFUtils();
            var pdfBytes = pdfGen.generate(htmlTemplate);
            
            var attachment = new GlideSysAttachment();
            var fileName = '资产申请_' + sysId + '.pdf';
            var attachmentId = attachment.write(
                gr.getTableName(), 
                sysId, 
                fileName, 
                'application/pdf', 
                pdfBytes
            );
            
            return attachmentId.toString(); // 必须返回字符串

        } catch (e) {
            return "ERROR: " + e.message;
        }
    },
    
    type: 'GlobalAjax'
});]]></script>
