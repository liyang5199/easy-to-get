        <name> PDFGenerationScript</name>
        <sandbox_callable>true</sandbox_callable>
        <script><![CDATA[var PDFGenerationScript = Class.create();
PDFGenerationScript.prototype = Object.extendsObject(AbstractAjaxProcessor, {
    
    generatePDF: function() {
        var tableName = this.getParameter('sysparm_table_name');
        var recordId = this.getParameter('sysparm_record_id');
        
        var gr = new GlideRecord(tableName);
        if (gr.get(recordId)) {
            var pdfContent = this._generatePDFContent(gr);
            var attachment = this._createAttachment(tableName, recordId, pdfContent);
            return attachment;
        }
        return '';
    },
    
    _generatePDFContent: function(gr) {
        var html = '<html><body style="font-family: Arial, sans-serif;">';
        html += '<h1>资产请求详情</h1>';
        html += '<p><strong>经理:</strong> ' + gr.getValue('manager') + '</p>';
        html += '<p><strong>请求人:</strong> ' + gr.getValue('request_for_dr') + '</p>';
        html += '<p><strong>计算机型号:</strong> ' + gr.getValue('computer_model') + '</p>';
        html += '<p><strong>请求状态:</strong> ' + gr.getValue('my_request_status') + '</p>';
        html += '<p><strong>备注:</strong> ' + gr.getValue('my_notes') + '</p>';
        html += '</body></html>';
        
        return html;
    },
    
    _createAttachment: function(tableName, recordId, htmlContent) {
        var pdfGen = new sn_ws.pdf.Generator();
        pdfGen.setContent(htmlContent);
        pdfGen.setOrientation('portrait');
        pdfGen.setSize('A4');
        
        var pdfData = pdfGen.generate();
        var attachment = new GlideSysAttachment();
        var sysId = attachment.write(tableName, recordId, 'Asset_Request_Details.pdf', 'application/pdf', pdfData);
        
        return sysId;
    },
    
    type: 'PDFGenerationScript'
});]]></script>
