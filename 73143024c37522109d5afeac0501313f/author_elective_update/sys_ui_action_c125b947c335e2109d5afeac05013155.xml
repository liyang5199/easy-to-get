        <script><![CDATA[// 添加确认对话框
if (confirm('确定要将此请求退回要求补充信息吗？')) {
    // 设置退回状态
    current.my_request_status = 'returned';
    
    // 确保有备注
    if (!current.my_notes) {
        current.my_notes = "请补充更多信息后重新提交";
    }
    
    // 更新记录
    current.update();
    
    // 显示成功消息
    g_form.addInfoMessage('请求已退回给申请人');
    
    // 刷新页面查看状态变化
    action.setRedirectURL(current);
}]]></script>
