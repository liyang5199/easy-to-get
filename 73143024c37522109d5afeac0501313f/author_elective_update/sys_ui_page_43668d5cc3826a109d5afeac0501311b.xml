<?xml version="1.0" encoding="UTF-8"?><record_update table="sys_ui_page">
    <sys_ui_page action="DELETE">
        <category>general</category>
        <client_script><![CDATA[function onSubmit() {
    try {
        // 获取输入值和记录的sys_id
        var comments = gel('comments_input').value;
        var sysId = gel('task_sys_id').value;

        if (!comments) {
            alert("Please enter comments!");
            return false;
        }

        // 调用Script Include的Ajax方法
        var ga = new GlideAjax('FieldUpdater');
        ga.addParam('sysparm_name', 'updateField');  // 调用方法名
        ga.addParam('sysparm_table', 'x_1770592_easy_t_0_my_asset_inventory'); // 替换为实际表名(如incident)
        ga.addParam('sysparm_sys_id', sysId);
        ga.addParam('sysparm_field', 'comments');    // 要更新的字段名
        ga.addParam('sysparm_value', comments);      // 新值
        
        ga.getXML(function(response) {
            var answer = response.responseXML.documentElement.getAttribute("answer");
            if (answer ='success') {
                GlideDialogWindow.get().destroy();
                g_form.refresh(); // 刷新父表单
            } else {
                alert("Update failed: " + answer);
            }
        });

    } catch (e) {
        console.error('Error:', e);
        alert("An error occurred. Check console for details.");
    }
    return false;
}

function onCancel() {
    GlideDialogWindow.get().destroy();
    return false;
}]]></client_script>
        <description/>
        <direct>false</direct>
        <endpoint>x_1770592_easy_t_0_Popup_Dialog .do</endpoint>
        <html><![CDATA[<?xml version="1.0" encoding="utf-8"?>
<j:jelly xmlns:j="jelly:core" xmlns:g="glide">
  <g:ui_form>
    <!-- 接收UI Action传递的sys_id -->
    <input type="hidden" id="task_sys_id" name="task_sys_id" value="${sysparm_sysid}"/>
    
    <!-- 对话框内容 -->
    <div style="padding: 20px;">
      <!-- 修改字段名称为 comments -->
      <g:ui_multiline_input_field 
        name="comments_input" 
        label="Update Comments" 
        mandatory="true"/>
    </div>
    
    <!-- 按钮保持不变 -->
    <g:dialog_buttons_ok_cancel 
      ok="return onSubmit();" 
      cancel="return onCancel();"/>
  </g:ui_form>
</j:jelly>]]></html>
