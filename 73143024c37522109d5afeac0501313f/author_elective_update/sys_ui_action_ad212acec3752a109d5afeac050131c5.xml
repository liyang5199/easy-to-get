        <onclick> generatePDF()</onclick>
        <order>100</order>
        <script><![CDATA[function generatePDF() {
    try {
        // 从URL获取sys_id的替代方法
        var sysId = (function() {
            // 尝试从g_form获取
            if (typeof g_form !== 'undefined' && typeof g_form.getUniqueValue === 'function') {
                return g_form.getUniqueValue();
            }
            // 从URL解析
            var matches = window.location.href.match(/sys_id=([^&]+)/);
            return matches ? matches[1] : null;
        })();
        
        if (!sysId) {
            alert('Error: Cannot determine record ID. Please open a record first.');
            return;
        }
        
        // 构建下载URL
        var apiUrl = 'api/x_1770592_easy_t_0/asset_request_pdf_generator/generate/' + sysId;
        
        // 触发下载
        window.location.href = apiUrl;
        
    } catch (e) {
        console.error('Error:', e);
        alert('Error generating PDF: ' + e.message);
    }
}]]></script>
